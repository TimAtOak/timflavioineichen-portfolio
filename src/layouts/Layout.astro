---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jost';

import type { Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Paths of this page per language, used for hreflang links. */
  alternates?: Partial<Record<Lang, string>>;
  /** JSON-LD object rendered into the head. */
  structuredData?: object;
}

const defaults = {
  de: {
    title: 'Tim Flavio Ineichen | Freelance Software Engineer & Architect',
    description: "Tim Flavio Ineichen – freiberuflicher Senior Software Engineer & Architect aus Luzern. CTO bei kimuno und Lead Developer bei Let's Doo. Skalierbare Webanwendungen, Software-Architektur und technische Leitung.",
  },
  en: {
    title: 'Tim Flavio Ineichen | Freelance Software Engineer & Architect',
    description: "Tim Flavio Ineichen – freelance Senior Software Engineer & Architect from Lucerne, Switzerland. CTO at kimuno and Lead Developer at Let's Doo. Scalable web applications, software architecture and technical leadership.",
  },
};

const { lang = 'de', alternates, structuredData } = Astro.props;
const title = Astro.props.title ?? defaults[lang].title;
const description = Astro.props.description ?? defaults[lang].description;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(lang === 'de' ? '/og-image.jpg' : '/og-image-en.jpg', Astro.site);
const alternateLinks = Object.entries(alternates ?? {}).map(([hreflang, path]) => ({
  hreflang,
  href: new URL(path, Astro.site).href,
}));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {alternateLinks.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
    {alternates?.de && <link rel="alternate" hreflang="x-default" href={new URL(alternates.de, Astro.site).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tim Flavio Ineichen" />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_US'} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tim Flavio Ineichen – Senior Software Engineer & Architect" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <meta name="theme-color" content="#edf1f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f131a" media="(prefers-color-scheme: dark)" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <!-- Prevent theme flash -->
    <script is:inline>
      (function () {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg:           #edf1f6;
    --bg-elev:      #ffffff;
    --bg-sunken:    #e4e9f0;
    --bg-card:      linear-gradient(160deg, #fafbfd 0%, #f1f4f8 100%);
    --ink:          #222833;
    --text:         #3b4352;
    --muted:        #6a7383;
    --faint:        #9ea6b4;
    --line:         #e2e7ee;
    --accent:       #1a87e6;
    --accent-hover: #0f74cc;
    --accent-soft:  #e5f1fc;
    --on-accent:    #ffffff;
    --ok:           #22a565;
    --shadow-sm:    0 1px 3px rgba(31, 52, 92, 0.06);
    --shadow:       0 2px 6px rgba(31, 52, 92, 0.04), 0 12px 32px -12px rgba(31, 52, 92, 0.16);
    --shadow-lg:    0 4px 12px rgba(31, 52, 92, 0.04), 0 40px 90px -30px rgba(31, 52, 92, 0.28);
    --glow:         0 10px 26px -8px rgba(26, 135, 230, 0.7);
    --name-shadow:  rgba(31, 52, 92, 0.12);

    --font-sans:    'Jost Variable', 'Jost', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-display: 'Archivo Variable', 'Archivo', 'Arial Black', system-ui, sans-serif;

    --wrap: 1240px;
    --gutter: clamp(16px, 4vw, 40px);
    --radius: 24px;
    --radius-sm: 14px;
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    --bg:           #0f131a;
    --bg-elev:      #181d26;
    --bg-sunken:    #12161d;
    --bg-card:      linear-gradient(160deg, #1a2029 0%, #141921 100%);
    --ink:          #eef2f8;
    --text:         #c7cfdb;
    --muted:        #8f99a8;
    --faint:        #5f6978;
    --line:         #252c37;
    --accent:       #3d9df0;
    --accent-hover: #64b2f5;
    --accent-soft:  rgba(61, 157, 240, 0.14);
    --on-accent:    #ffffff;
    --ok:           #4ade80;
    --shadow-sm:    0 1px 3px rgba(0, 0, 0, 0.3);
    --shadow:       0 2px 6px rgba(0, 0, 0, 0.25), 0 12px 32px -12px rgba(0, 0, 0, 0.6);
    --shadow-lg:    0 4px 12px rgba(0, 0, 0, 0.25), 0 40px 90px -30px rgba(0, 0, 0, 0.8);
    --glow:         0 10px 26px -8px rgba(61, 157, 240, 0.6);
    --name-shadow:  rgba(0, 0, 0, 0.5);
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 96px;
    -webkit-text-size-adjust: 100%;
  }

  html, body {
    margin: 0;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }

  body { transition: background-color 0.3s ease, color 0.3s ease; }

  img { max-width: 100%; display: block; }

  a { color: inherit; }

  ::selection { background: var(--accent); color: var(--on-accent); }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* ── Shared primitives ─────────────────────────────── */
  .wrap {
    width: 100%;
    max-width: calc(var(--wrap) + var(--gutter) * 2);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .section { padding: clamp(64px, 9vw, 120px) 0; }

  .section-head {
    max-width: 760px;
    margin-bottom: clamp(36px, 5vw, 60px);
  }

  .section-head.center { margin-left: auto; margin-right: auto; text-align: center; }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
  }

  .eyebrow::before {
    content: '';
    width: 22px;
    height: 3px;
    border-radius: 3px;
    background: currentColor;
  }

  .section-title {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: var(--ink);
    margin: 0;
    overflow-wrap: break-word;
  }

  @media (max-width: 560px) {
    .section-title { font-stretch: 100%; font-size: clamp(1.7rem, 8vw, 2.2rem); hyphens: auto; }
  }

  .section-lead {
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 58ch;
    margin: 1rem 0 0;
  }

  .section-head.center .section-lead { margin-left: auto; margin-right: auto; }

  .card {
    background: var(--bg-elev);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 50px;
    padding: 0 1.6rem;
    border-radius: 14px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.25s ease, transform 0.25s var(--ease);
  }

  .btn svg { transition: transform 0.25s var(--ease); }
  .btn:hover { transform: translateY(-2px); }
  .btn:hover svg.arrow { transform: translateX(3px); }

  .btn-primary { background: var(--accent); color: var(--on-accent); box-shadow: var(--glow); }
  .btn-primary:hover { background: var(--accent-hover); }

  .btn-ghost { background: var(--bg-elev); color: var(--ink); box-shadow: var(--shadow); }
  .btn-ghost:hover { color: var(--accent); }

  /* ── Scroll reveal ─────────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
  }

  .reveal.is-visible { opacity: 1; transform: none; }

  .d1 { transition-delay: 0.08s; }
  .d2 { transition-delay: 0.16s; }
  .d3 { transition-delay: 0.24s; }
  .d4 { transition-delay: 0.32s; }
  .d5 { transition-delay: 0.40s; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  function initReveal() {
    const els = document.querySelectorAll('.reveal');
    if (!els.length) return;
    if (!('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            obs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    els.forEach((el) => obs.observe(el));
  }

  function initThemeToggle() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const html = document.documentElement;
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    });
  }

  initReveal();
  initThemeToggle();
</script>
