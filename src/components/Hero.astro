  </nav>

  <div class="hero-content">
    <div class="intro-container">
      <div class="intro-text">
        <div class="welcome-tag">👋 Hallo, ich bin</div>
        <h1 class="name">Tim Flavio Ineichen</h1>
        <div class="role-container">
          <div class="roles">
            <span class="role">Software-Architekt</span>
            <span class="role">Tech Lead</span>
            <span class="role">Freelancer</span>
          </div>
        </div>
        <p class="bio">
          Ich konzipiere und entwickle skalierbare Softwarelösungen und Webanwendungen.
          Mit Erfahrung von der Full-Stack-Entwicklung bis zur Software-Architektur
          schaffe ich Lösungen, die echten Geschäftsanforderungen entsprechen.
        </p>
        <div class="tech-stack">
          <div class="tech-item">
            <span class="tech-label">Schwerpunkte</span>
            <div class="tech-pills">
              <span>QM-Systeme</span>
              <span>Webanwendungen</span>
              <span>Full-Stack</span>
            </div>
          </div>
          <div class="tech-item">
            <span class="tech-label">Tech Stack</span>
            <div class="tech-pills">
              <span>Python</span>
              <span>TypeScript</span>
              <span>React</span>
              <span>Astro</span>
              <span>APIs</span>
              <span>PHP</span>
            </div>
          </div>
        </div>
        <div class="cta-buttons">
          <a href="#contact" class="primary-btn">Projekt anfragen</a>
          <a href="/src/assets/Tim_Flavio_Ineichen_Lebenslauf.pdf" class="secondary-btn" download="Tim_Flavio_Ineichen_Lebenslauf.pdf" target="_blank">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Lebenslauf
          </a>
        </div>
      </div>
      <div class="intro-visual">
        <div class="code-window">
          <div class="window-header">
            <div class="window-buttons">
              <span></span><span></span><span></span>
            </div>
            <span class="window-title">contractor.ts</span>
          </div>
          <div class="window-content">
            <pre><code>{`class SoftwareArchitect {
  private skills: string[] = [
    'System Design',
    'Cloud Architecture',
    'Team Leadership'
  ];

  public async buildSolution(
    problem: Challenge
  ): Promise<Solution> {
    const architecture = await
      designArchitecture(problem);

    return implement(
      architecture,
      this.skills
    );
  }
}`}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #hero {
    min-height: 100vh;
    background: linear-gradient(135deg, var(--hero-from) 0%, var(--hero-to) 100%);
    position: relative;
    display: flex;
    flex-direction: column;
    color: var(--text);
    transition: background 0.3s ease;
  }

  /* Navigation */
  #main-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 40px;
    background: var(--nav-bg);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--nav-border);
    transform: translateY(-100%);
    animation: flyInFromTop 0.9s ease-out 0.4s forwards;
  }

  .nav-links {
    display: flex;
    gap: 8px;
    transform: translateX(-40px);
    opacity: 0;
    animation: flyInFromLeft 0.9s ease-out 0.9s forwards;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    transition: all 0.25s ease;
  }

  .nav-links a:hover {
    color: var(--text);
    background: var(--surface);
  }

  .nav-links a.active {
    color: var(--accent-soft);
    background: var(--accent-dim);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
    transform: translateX(40px);
    opacity: 0;
    animation: flyInFromRight 0.9s ease-out 1.1s forwards;
  }

  /* Theme Toggle */
  .theme-toggle {
    background: var(--toggle-bg);
    border: 1px solid var(--toggle-border);
    color: var(--toggle-color);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--accent-soft);
    border-color: var(--border-hover);
    transform: rotate(15deg);
  }

  [data-theme="dark"] .icon-moon { display: none; }
  [data-theme="light"] .icon-sun { display: none; }

  /* Social icons */
  .social-icons {
    display: flex;
    gap: 10px;
  }

  .social-icons a {
    color: var(--text-muted);
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--toggle-bg);
    border: 1px solid var(--toggle-border);
    transition: all 0.25s ease;
  }

  .social-icons a:hover {
    color: var(--accent-soft);
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  /* Animations */
  @keyframes flyInFromTop {
    to { transform: translateY(0); opacity: 1; }
  }
  @keyframes flyInFromLeft {
    to { transform: translateX(0); opacity: 1; }
  }
  @keyframes flyInFromRight {
    to { transform: translateX(0); opacity: 1; }
  }

  /* Hero Content */
  .hero-content {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 2rem;
    margin-top: 4rem;
  }

  .intro-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .welcome-tag {
    display: inline-block;
    background: var(--welcome-bg);
    color: var(--welcome-color);
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .name {
    font-size: 3.75rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1rem 0;
    background: linear-gradient(135deg, var(--name-from) 0%, var(--name-to) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .roles {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .role {
    font-size: 1.1rem;
    color: var(--role-color);
    position: relative;
  }

  .role:not(:last-child)::after {
    content: '·';
    margin-left: 1rem;
    color: var(--text-faint);
  }

  .bio {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .tech-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .tech-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tech-label {
    font-size: 0.75rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-pills span {
    background: var(--pill-bg);
    color: var(--pill-color);
    padding: 0.2rem 0.7rem;
    border-radius: 9999px;
    font-size: 0.82rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .primary-btn, .secondary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .primary-btn {
    background: var(--accent);
    color: #fff;
  }

  .primary-btn:hover {
    background: var(--accent-soft);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);
  }

  .secondary-btn {
    background: var(--accent-dim);
    color: var(--accent-soft);
    border: 1px solid var(--border);
  }

  .secondary-btn:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  /* Code window — always dark */
  .code-window {
    background: #1e293b;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .window-header {
    background: #273548;
    padding: 0.7rem 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .window-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .window-buttons span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .window-buttons span:nth-child(1) { background: #ef4444; }
  .window-buttons span:nth-child(2) { background: #f59e0b; }
  .window-buttons span:nth-child(3) { background: #10b981; }

  .window-title {
    color: #64748b;
    font-size: 0.82rem;
  }

  .window-content {
    padding: 1.5rem;
  }

  .window-content pre {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.75;
    color: #e2e8f0;
  }

  .keyword  { color: #f472b6; }
  .class-name { color: #60a5fa; }
  .type     { color: #818cf8; }
  .string   { color: #34d399; }
  .function { color: #f59e0b; }

  /* Responsive */
  @media (max-width: 768px) {
    #main-nav {
      padding: 12px 16px;
    }

    .nav-links {
      gap: 4px;
    }

    .nav-links a {
      font-size: 0.78rem;
      padding: 5px 10px;
    }

    .hero-content {
      padding: 1.5rem 1rem;
      text-align: center;
    }

    .intro-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .name {
      font-size: 2.75rem;
    }

    .roles {
      justify-content: center;
    }

    .tech-stack { align-items: center; }
    .tech-pills { justify-content: center; }
    .cta-buttons { justify-content: center; }
  }

  @media (max-width: 480px) {
    #main-nav {
      flex-direction: column;
      gap: 10px;
      background: var(--nav-bg);
    }

    .nav-right {
      transform: none;
      opacity: 0;
      animation: flyInFromRight 0.9s ease-out 1.1s forwards;
    }
  }
</style>

<script>
  // Syntax highlighting for code window
  const codeEl = document.querySelector('.window-content code');
  if (codeEl) {
    const highlighted = (codeEl.textContent || '')
      .replace(/\b(class|private|public|async|const|return|this)\b/g, '<span class="keyword">$1</span>')
      .replace(/\b(SoftwareArchitect)\b/g, '<span class="class-name">$1</span>')
      .replace(/\b(string|Challenge|Promise|Solution)\b/g, '<span class="type">$1</span>')
      .replace(/\b(buildSolution|designArchitecture|implement)\b/g, '<span class="function">$1</span>')
      .replace(/('[^']*')/g, '<span class="string">$1</span>');
    codeEl.innerHTML = highlighted;
  }
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Theme toggle
    const toggle = document.getElementById('theme-toggle');
    toggle?.addEventListener('click', function () {
      const html = document.documentElement;
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });

    // Smooth scroll for nav links
    const navLinks = document.querySelectorAll('.nav-links a');
    navLinks.forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        const id = this.getAttribute('href').substring(1);
        const el = document.getElementById(id);
        if (el) {
          window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
        }
      });
    });

    // Active nav link on scroll
    function updateActive() {
      const pos = window.scrollY + 140;
      navLinks.forEach(function (link) {
        const id = link.getAttribute('href').substring(1);
        const el = document.getElementById(id);
        if (el) {
          const inView = pos >= el.offsetTop && pos < el.offsetTop + el.offsetHeight;
          link.classList.toggle('active', inView);
        }
      });
    }

    let ticking = false;
    window.addEventListener('scroll', function () {
      if (!ticking) {
        requestAnimationFrame(function () { updateActive(); ticking = false; });
        ticking = true;
      }
    });
    updateActive();
  });
</script>
