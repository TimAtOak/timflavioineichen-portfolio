---
import { Image } from 'astro:assets';
import Floaters from "./Floaters.astro";
import timPhoto from '../assets/tim-ineichen.png';

import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;

const t = {
  de: {
    status: 'Portfolio',
    hello: 'Hallo, ich bin',
    lead: 'Willkommen in meinem Portfolio. Ich konzipiere, baue und verantworte Software – von der ersten Anforderung über eine tragfähige Architektur bis zum stabilen Betrieb.',
    cta: 'Kontakt aufnehmen',
    cv: 'Lebenslauf',
    mail: 'E-Mail senden',
    roles: 'Aktuelle Tätigkeiten',
    freelance: 'Software Engineering & Architektur',
    facts: [
      { value: '7+', label: 'Jahre Berufserfahrung in der Softwareentwicklung' },
      { value: 'End-to-End', label: 'Von Requirements über Architektur bis Deployment' },
      { value: 'ISO 9001', label: 'Erfahrung mit QM-Software in regulierten Umfeldern' },
      { value: 'DE · EN', label: 'Deutsch & Englisch (C1) – Basis Kriens / Luzern' },
    ],
  },
  en: {
    status: 'Portfolio',
    hello: "Hi, I'm",
    lead: 'Welcome to my portfolio. I design, build and take ownership of software – from the first requirement through a solid architecture to stable operation.',
    cta: 'Get in touch',
    cv: 'CV (German)',
    mail: 'Send an email',
    roles: 'Current roles',
    freelance: 'Software Engineering & Architecture',
    facts: [
      { value: '7+', label: 'Years of professional software development' },
      { value: 'End-to-End', label: 'From requirements and architecture to deployment' },
      { value: 'ISO 9001', label: 'Experience with QMS software in regulated environments' },
      { value: 'DE · EN', label: 'German & English (C1) – based in Kriens / Lucerne' },
    ],
  },
}[lang];

const roles = [
  {
    role: 'Freelance',
    org: t.freelance,
    icon: 'M8 6l-6 6 6 6M16 6l6 6-6 6M14 4l-4 16',
  },
  {
    role: 'CTO',
    org: 'kimuno GmbH',
    url: 'https://kimuno.ch/',
    icon: 'M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z',
  },
  {
    role: 'Lead Developer',
    org: "Let's Doo GmbH",
    url: 'https://letsdoo.it/',
    icon: 'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM17 14v6M14 17h6',
  },
];

const facts = t.facts;
---
<section id="top" class="hero">
  <Floaters set="hero" />

  <div class="wrap">
    <div class="hero-grid">
      <div class="copy">
        <p class="status reveal rv-pop">
          <span class="status-dot" aria-hidden="true"></span>
          {t.status}
        </p>
        <p class="hello reveal rv-left d1">{t.hello}</p>
        <h1 class="name reveal rv-blur d1">Tim Flavio<br />Ineichen</h1>
        <p class="title reveal d2">Senior Software Engineer &amp; Architect</p>
        <p class="lead reveal d2">
          {t.lead}
        </p>

        <div class="actions reveal rv-stagger rv-pop d3">
          <a href="#kontakt" class="btn btn-primary">
            {t.cta}
            <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="/Tim_Ineichen_Lebenslauf.pdf" class="btn btn-ghost" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            {t.cv}
          </a>
        </div>

        <div class="reach reveal rv-zoom d4">
          <span class="mail-bubble">kontakt@alpzen-group.ch</span>
          <div class="socials">
            <a href="mailto:kontakt@alpzen-group.ch" class="social is-primary" aria-label={t.mail}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/tim-flavio-ineichen-269a231a8/" class="social" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452z"/></svg>
            </a>
            <a href="https://github.com/TimAtOak" class="social" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="visual">
        <span class="halo" aria-hidden="true"></span>
        <Image src={timPhoto} alt="Tim Flavio Ineichen" width={760} loading="eager" class="portrait" />
      </div>

      <ul class="roles" aria-label={t.roles}>
        {roles.map((r, i) => (
          <li class={`role reveal rv-right d${i + 2}`} style={`--i:${i}`}>
            <div class="tile" aria-hidden="true">
              <span class="tile-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={r.icon}/></svg>
              </span>
            </div>
            <span class="connector" aria-hidden="true"></span>
            <div class="label">
              <strong>{r.role}</strong>
              {r.url
                ? <a href={r.url} target="_blank" rel="noopener">{r.org} ↗</a>
                : <span>{r.org}</span>}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <dl class="facts">
      {facts.map((f, i) => (
        <div class={`fact reveal rv-up d${i + 1}`}>
          <dt>{f.value}</dt>
          <dd>{f.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 80px 0 clamp(24px, 4vw, 48px);
    overflow: hidden; /* fallback for Safari < 16 */
    overflow: clip;
  }

  .hero > .wrap { position: relative; z-index: 1; }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.95fr) minmax(0, 0.7fr);
    grid-template-areas: "copy visual roles";
    min-height: clamp(500px, calc(100vh - 260px), 720px);
  }

  /* Copy */
  .copy {
    grid-area: copy;
    align-self: center;
    position: relative;
    z-index: 2;
    padding: clamp(24px, 4vw, 72px) 0;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.75rem;
    padding: 0.35rem 0.9rem 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    animation: ping 2.4s ease-out infinite;
  }

  @keyframes ping {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent); }
    80%, 100% { box-shadow: 0 0 0 8px transparent; }
  }

  .hello {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.6rem;
  }

  .name {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: clamp(2.2rem, 3.9vw, 3.75rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 1.1rem;
    text-shadow: 3px 3px 0 var(--bg-elev), 5px 5px 0 var(--name-shadow);
  }

  .title {
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 0.75rem;
    letter-spacing: 0.02em;
  }

  .lead {
    color: var(--muted);
    max-width: 40ch;
    margin: 0 0 2rem;
    line-height: 1.75;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem; }

  .reach { display: grid; justify-items: start; gap: 0.9rem; }

  .mail-bubble {
    position: relative;
    font-size: 0.85rem;
    color: var(--text);
    background: var(--bg-elev);
    padding: 0.5rem 0.95rem;
    border-radius: 10px;
    box-shadow: var(--shadow);
  }

  .mail-bubble::after {
    content: '';
    position: absolute;
    left: 22px;
    bottom: -6px;
    width: 12px;
    height: 12px;
    background: var(--bg-elev);
    transform: rotate(45deg);
    border-radius: 2px;
  }

  .socials { display: flex; gap: 0.7rem; }

  .social {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg-elev);
    color: var(--ink);
    box-shadow: var(--shadow);
    transition: transform 0.25s var(--ease), color 0.2s ease;
  }

  .social:hover { transform: translateY(-3px); color: var(--accent); }
  .social.is-primary { background: var(--accent); color: var(--on-accent); box-shadow: var(--glow); }
  .social.is-primary:hover { color: var(--on-accent); }

  /* Visual */
  .visual {
    grid-area: visual;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .halo {
    position: absolute;
    top: 12%;
    left: 50%;
    width: 128%;
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 45%,
      color-mix(in srgb, var(--bg-elev) 95%, transparent) 0%,
      color-mix(in srgb, var(--bg-elev) 55%, transparent) 55%,
      transparent 70%);
  }

  .visual :global(.portrait) {
    position: relative;
    width: auto;
    height: clamp(460px, calc(100vh - 290px), 680px);
    max-width: none;
    object-fit: contain;
    object-position: bottom;
    filter: drop-shadow(0 30px 40px rgba(31, 52, 92, 0.18));
  }

  /* Role cards */
  .roles {
    grid-area: roles;
    list-style: none;
    margin: 0;
    padding: clamp(32px, 5vw, 64px) 0;
    align-self: center;
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.6rem;
  }

  .role {
    width: min(100%, 210px);
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: float 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -2s);
  }

  .role:nth-child(2) { justify-self: end; }
  .role:nth-child(3) { justify-self: center; }

  /* Fly in, then keep floating (both animations run side by side) */
  .roles .role.is-visible {
    animation:
      var(--rv) var(--rv-dur, 0.9s) cubic-bezier(0.16, 1, 0.3, 1) var(--rv-delay, 0s) backwards,
      float 6s ease-in-out calc(var(--i) * -2s) infinite;
  }

  @keyframes float {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -8px; }
  }

  .tile {
    width: 100%;
    height: 78px;
    display: grid;
    place-items: center;
    background: var(--bg-elev);
    border-radius: 18px;
    box-shadow: var(--shadow);
  }

  .tile-icon {
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    color: #ffffff;
    background: linear-gradient(140deg, #5fb3f7, var(--accent));
    box-shadow: var(--glow);
  }

  .connector {
    position: relative;
    width: 2px;
    height: 16px;
    background: var(--faint);
  }

  .connector::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
    translate: -50% -50%;
  }

  .label {
    width: 100%;
    display: grid;
    justify-items: center;
    gap: 0.05rem;
    text-align: center;
    background: var(--bg-elev);
    border-radius: 14px;
    box-shadow: var(--shadow);
    padding: 0.7rem 1rem;
  }

  .label strong { color: var(--ink); font-weight: 600; font-size: 0.98rem; }
  .label span, .label a { color: var(--muted); font-size: 0.82rem; text-decoration: none; line-height: 1.4; }
  .label a:hover { color: var(--accent); }

  /* Facts */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .fact { padding: 1.6rem 1.5rem 0; }
  .fact:first-child { padding-left: 0; }
  .fact + .fact { border-left: 1px solid var(--line); }

  .fact dt {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .fact dd { margin: 0; font-size: 0.9rem; color: var(--muted); line-height: 1.5; }

  @media (max-width: 1100px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: "copy copy" "roles visual";
    }
    .copy { padding-bottom: 0; }
    .roles { align-self: end; padding-bottom: 48px; }
    .role, .role:nth-child(2), .role:nth-child(3) { justify-self: start; }
    .visual { min-height: 520px; }
    .visual :global(.portrait) { height: 520px; }
    .facts { grid-template-columns: repeat(2, 1fr); row-gap: 1.5rem; }
    .fact, .fact + .fact { border-left: 0; padding-left: 0; }
  }

  @media (max-width: 700px) {
    .hero { padding-top: 88px; }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "copy" "roles" "visual";
    }
    .name { font-size: clamp(1.7rem, 9.2vw, 2.6rem); }
    .roles { padding: 2rem 0 0; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .role { width: 100%; animation: none; flex-direction: row; }
    .roles .role.is-visible { animation: var(--rv) 0.9s cubic-bezier(0.16, 1, 0.3, 1) var(--rv-delay, 0s) backwards; }
    .tile { width: 64px; height: 64px; flex-shrink: 0; }
    .tile-icon { width: 40px; height: 40px; border-radius: 12px; }
    .tile-icon svg { width: 22px; height: 22px; }
    .connector { width: 14px; height: 2px; }
    .label { justify-items: start; text-align: left; }
    .visual { min-height: 0; padding-top: 1rem; }
    .visual :global(.portrait) { height: auto; width: 100%; max-width: 380px; }
    .halo { width: 100%; top: 6%; }
    .facts { grid-template-columns: 1fr 1fr; }
    .fact { padding-top: 1.1rem; }
    .fact dt { font-size: 1.1rem; font-stretch: 100%; }
    .actions .btn { flex: 1 1 auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .role, .status-dot { animation: none; }
  }
</style>
