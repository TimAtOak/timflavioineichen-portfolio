---
const services = [
  {
    title: 'Software-Architektur',
    text: 'Tragfähige System- und API-Architekturen, fundierte Technologieentscheide und Architektur-Reviews bestehender Systeme – mit Blick auf Skalierbarkeit, Qualität und Wartbarkeit.',
    tags: ['System Design', 'API-Design', 'Reviews', 'Cloud'],
    icon: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  },
  {
    title: 'Full-Stack-Entwicklung',
    text: 'Umsetzung kompletter Webanwendungen von Frontend bis Backend – inklusive Datenbank, Schnittstellen und produktivem Deployment.',
    tags: ['React / TS', 'Symfony', 'Python', 'C#'],
    icon: 'M8 6l-6 6 6 6M16 6l6 6-6 6',
  },
  {
    title: 'Technische Leitung',
    text: 'Tech Lead auf Zeit oder Interim-CTO: Entwicklungsstandards, Prozesse, Code Reviews und Coaching von Teams – damit Ihr Team schneller und sicherer liefert.',
    tags: ['Tech Lead', 'Interim CTO', 'Scrum', 'Code Reviews'],
    icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  },
  {
    title: 'Requirements & Konzeption',
    text: 'Fachliche Anforderungen verstehen, strukturieren und in User Stories, technische Konzepte und realistische Machbarkeitsbewertungen übersetzen.',
    tags: ['Requirements', 'User Stories', 'Workshops', 'Machbarkeit'],
    icon: 'M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M9 14l2 2 4-4',
  },
  {
    title: 'KI, ERP & Integrationen',
    text: 'Anbindung von Drittsystemen, Automatisierung von Geschäftsprozessen mit KI und Erweiterungen von Plattformen wie Odoo über saubere Schnittstellen.',
    tags: ['KI', 'Odoo', 'REST / APIs', 'Automatisierung'],
    icon: 'M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z',
  },
  {
    title: 'Frontend & Design Systems',
    text: 'Komponentenbibliotheken in React, konsistente UI/UX und performante Frontends, die Entwickler gerne verwenden und Nutzer gerne bedienen.',
    tags: ['Component Library', 'UI/UX', 'Accessibility', 'Performance'],
    icon: 'M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69z',
  },
];

const steps = [
  { title: 'Erstgespräch', text: 'Kostenlos und unverbindlich: Wir klären Ziel, Ausgangslage und Rahmenbedingungen.' },
  { title: 'Konzept & Angebot', text: 'Sie erhalten einen klaren Vorschlag zu Vorgehen, Aufwand und Zeitplan.' },
  { title: 'Umsetzung', text: 'Iterativ, transparent und mit regelmässigen Abstimmungen – remote oder vor Ort.' },
  { title: 'Übergabe & Begleitung', text: 'Dokumentation, Wissenstransfer an Ihr Team und auf Wunsch langfristige Betreuung.' },
];
---
<section id="leistungen" class="section">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">Leistungen</p>
      <h2 class="section-title">Was ich für Ihr Projekt übernehme.</h2>
      <p class="section-lead">
        Ich steige dort ein, wo Sie Unterstützung brauchen – als Architekt, Entwickler oder
        technische Leitung. Projektbasiert oder als Verstärkung Ihres Teams.
      </p>
    </div>

    <ul class="services">
      {services.map((s, i) => (
        <li class={`service reveal d${(i % 3) + 1}`}>
          <span class="service-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon}/></svg>
          </span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <div class="tags">{s.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </li>
      ))}
    </ul>

    <div class="process reveal">
      <h3 class="process-title">So arbeiten wir zusammen</h3>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-num">{i + 1}</span>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(36px, 4vw, 56px) clamp(24px, 4vw, 56px);
  }

  .service {
    display: flex;
    flex-direction: column;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .service-icon { transition: transform 0.35s var(--ease); }
  .service:hover .service-icon { transform: translateY(-4px) rotate(-4deg); }

  .service-icon {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    color: #ffffff;
    background: linear-gradient(140deg, #5fb3f7, var(--accent));
    box-shadow: var(--glow);
    margin-bottom: 1.5rem;
  }

  .service h3 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 1.15rem;
    font-weight: 750;
    color: var(--ink);
    margin: 0 0 0.6rem;
  }

  .service p {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.7;
    margin: 0 0 1.4rem;
    flex: 1;
  }

  /* Process */
  .process { margin-top: clamp(72px, 9vw, 112px); }

  .process-title {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 2rem;
    text-align: center;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 3vw, 40px);
    position: relative;
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 12%;
    right: 12%;
    border-top: 2px dashed var(--line);
  }

  .steps li { position: relative; text-align: center; }

  .step-num {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: var(--bg-elev);
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 800;
    box-shadow: var(--shadow), inset 0 0 0 2px var(--accent-soft);
  }

  .steps h4 { margin: 0 0 0.35rem; font-size: 1.05rem; color: var(--ink); font-weight: 600; }
  .steps p { margin: 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }

  @media (max-width: 1000px) {
    .services { grid-template-columns: repeat(2, 1fr); }
    .steps { grid-template-columns: repeat(2, 1fr); row-gap: 2rem; }
    .steps::before { display: none; }
  }

  @media (max-width: 620px) {
    .services { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; }
  }
</style>
