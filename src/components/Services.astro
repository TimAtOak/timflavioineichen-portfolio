---
import Floaters from './Floaters.astro';
import ProcessSteps from './ProcessSteps.astro';
import { getServices } from '../data/services';
import { servicePath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;

const t = {
  de: {
    eyebrow: 'Leistungen',
    title: 'Woran ich arbeite.',
    lead: 'Das sind meine fachlichen Schwerpunkte – als Architekt, Entwickler und technische Leitung, in einzelnen Projekten wie auch im Team.',
    more: 'Mehr erfahren',
  },
  en: {
    eyebrow: 'Services',
    title: 'What I work on.',
    lead: 'These are my main areas of expertise – as architect, developer and technical lead, on individual projects as well as within teams.',
    more: 'Learn more',
  },
}[lang];

const services = getServices(lang);
---
<section id="leistungen" class="section">
  <Floaters set="services" />
  <div class="wrap">
    <div class="section-head center reveal rv-stagger rv-blur">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-lead">{t.lead}</p>
    </div>

    <ul class="services">
      {services.map((s, i) => (
        <li class={`service reveal rv-tilt d${(i % 3) + 1}`}>
          <span class="service-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon}/></svg>
          </span>
          <h3><a href={servicePath(lang, s.slug)} class="service-link">{s.title}</a></h3>
          <p>{s.text}</p>
          <div class="tags">{s.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          <span class="more" aria-hidden="true">{t.more} <span>→</span></span>
        </li>
      ))}
    </ul>

    <ProcessSteps lang={lang} />
  </div>
</section>

<style>
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(36px, 4vw, 56px) clamp(24px, 4vw, 56px);
  }

  .service {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    transition: border-color 0.3s ease;
  }

  .service:hover { border-top-color: var(--accent); }

  /* Whole card is clickable via the heading link (keeps one accessible link per card) */
  .service-link { color: inherit; text-decoration: none; }
  .service-link::after { content: ''; position: absolute; inset: 0; }
  .service-link:focus-visible { outline: none; }
  .service:has(.service-link:focus-visible) { outline: 2px solid var(--accent); outline-offset: 8px; border-radius: 6px; }

  .service-icon {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    color: #ffffff;
    background: linear-gradient(140deg, #5fb3f7, var(--accent));
    box-shadow: var(--glow);
    margin-bottom: 1.5rem;
    transition: transform 0.35s var(--ease);
  }

  .service:hover .service-icon { transform: translateY(-4px) rotate(-4deg); }

  .service h3 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 1.15rem;
    font-weight: 750;
    color: var(--ink);
    margin: 0 0 0.6rem;
    transition: color 0.2s ease;
  }

  .service:hover h3 { color: var(--accent); }

  .service p {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.7;
    margin: 0 0 1.4rem;
    flex: 1;
  }

  .more {
    margin-top: 1.2rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--accent);
  }

  .more span { display: inline-block; transition: transform 0.3s var(--ease); }
  .service:hover .more span { transform: translateX(4px); }

  .wrap > :global(.process) { margin-top: clamp(72px, 9vw, 112px); }

  @media (max-width: 1000px) {
    .services { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 620px) {
    .services { grid-template-columns: minmax(0, 1fr); }
  }
</style>
