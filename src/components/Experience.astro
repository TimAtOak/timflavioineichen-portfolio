---
import { positions as positionsByLang } from '../data/experience';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const positions = positionsByLang[lang];

const t = {
  de: {
    eyebrow: 'Werdegang',
    title: 'Vom Applikationsentwickler zum Architekten.',
    lead: 'Stationen in Agenturen, Produktunternehmen und Start-ups – vom Entwickeln über das Führen von Teams bis zur technischen Gesamtverantwortung.',
  },
  en: {
    eyebrow: 'Experience',
    title: 'From application developer to architect.',
    lead: 'Roles at agencies, product companies and start-ups – from writing code to leading teams to overall technical responsibility.',
  },
}[lang];
---
<section id="werdegang" class="section">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-lead">{t.lead}</p>
    </div>

    <ol class="timeline reveal">
      {positions.map((p, i) => (
        <li class={`entry${p.current ? ' is-current' : ''}`}>
          <span class="marker" aria-hidden="true"></span>
          <details open={i < 3}>
            <summary>
              <span class="period">
                {p.current && <span class="dot" aria-hidden="true"></span>}
                {p.period}
              </span>
              <span class="entry-head">
                <span class="role">{p.role}</span>
                <span class="company">
                  {p.url
                    ? <a href={p.url} target="_blank" rel="noopener">{p.company} ↗</a>
                    : p.company}
                </span>
              </span>
              <span class="toggle" aria-hidden="true"></span>
            </summary>
            <div class="entry-body">
              <p class="summary">{p.summary}</p>
              <ul class="points">
                {p.points.map((pt) => <li>{pt}</li>)}
              </ul>
              {p.stack && (
                <div class="tags">{p.stack.map((t) => <span class="tag">{t}</span>)}</div>
              )}
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0 auto;
    max-width: 980px;
    padding: 0;
  }

  .entry {
    position: relative;
    padding: 1.5rem 0 1.5rem 2rem;
    border-bottom: 1px solid var(--line);
  }

  .entry:last-child { border-bottom: 0; }

  /* Vertical rail */
  .entry::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--line);
  }

  .entry:first-child::before { top: 2.1rem; }
  .entry:last-child::before { bottom: calc(100% - 2.1rem); }

  .marker {
    position: absolute;
    left: 0;
    top: 1.85rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg-elev);
    box-shadow: inset 0 0 0 2px var(--faint);
  }

  .is-current .marker { background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }

  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 170px 1fr auto;
    gap: 1.25rem;
    align-items: start;
    cursor: pointer;
  }

  summary::-webkit-details-marker { display: none; }

  .period {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    justify-self: start;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
    background: var(--bg-sunken);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-top: 0.2rem;
    white-space: nowrap;
  }

  .is-current .period { color: var(--accent); background: var(--accent-soft); }

  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); }

  .entry-head { display: grid; gap: 0.1rem; }

  .role {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 750;
    color: var(--ink);
    line-height: 1.35;
  }

  .company { color: var(--muted); font-size: 0.95rem; }
  .company a { color: var(--accent); text-decoration: none; font-weight: 500; }
  .company a:hover { text-decoration: underline; }

  .toggle {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--bg-elev);
    box-shadow: var(--shadow);
    transition: transform 0.3s var(--ease);
  }

  .toggle::before,
  .toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    translate: -50% -50%;
  }

  .toggle::after { rotate: 90deg; transition: rotate 0.3s var(--ease); }
  details[open] .toggle::after { rotate: 0deg; }
  summary:hover .toggle { transform: scale(1.08); }

  .entry-body { padding: 0.9rem 0 0 calc(170px + 1.25rem); }

  .summary { margin: 0 0 0.75rem; color: var(--text); max-width: 64ch; }

  .points {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
    max-width: 64ch;
  }

  .points li {
    position: relative;
    padding-left: 1.3rem;
    color: var(--muted);
    font-size: 0.97rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  @media (max-width: 760px) {
    summary { grid-template-columns: 1fr auto; }
    .period { grid-column: 1 / -1; grid-row: 1; margin-top: 0; }
    .entry-head { grid-row: 2; }
    .toggle { grid-row: 2; }
    .entry-body { padding-left: 0; }
  }
</style>
