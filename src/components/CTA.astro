---
import QRCode from 'qrcode';
import Floaters from './Floaters.astro';
import { vcardPath } from '../data/contact';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;

const t = {
  de: {
    eyebrow: 'Kontakt',
    title: 'Lassen Sie uns in Kontakt treten.',
    lead: 'Ob Fragen zu meiner Arbeit, fachlicher Austausch oder einfach ein Hallo – schreiben Sie mir, ich freue mich über Ihre Nachricht.',
    email: 'E-Mail', location: 'Standort', locationValue: 'Kriens / Luzern, Schweiz',
    languages: 'Sprachen', languagesValue: 'Deutsch, Englisch', cv: 'Lebenslauf',
    name: 'Name', namePh: 'Ihr Name', mailPh: 'ihre@email.ch',
    company: 'Unternehmen', optional: '(optional)', companyPh: 'Ihr Unternehmen',
    message: 'Worum geht es?', messagePh: 'Ihre Nachricht an mich …',
    error: 'Bitte füllen Sie Name, E-Mail und Nachricht aus.',
    saveTitle: 'Kontakt speichern',
    saveText: 'Code mit der Handy-Kamera scannen und meine Kontaktdaten mit einem Tipp im Adressbuch speichern.',
    saveTextTouch: 'Meine Kontaktdaten mit einem Tipp in Ihrem Adressbuch speichern.',
    saveBtn: 'vCard herunterladen', saveBtnTouch: 'Kontakt speichern',
    submit: 'Nachricht senden', note: 'Öffnet Ihr E-Mail-Programm mit einer vorausgefüllten Nachricht.',
    mail: { subject: 'Nachricht von', email: 'E-Mail', company: 'Unternehmen', message: 'Nachricht' },
  },
  en: {
    eyebrow: 'Contact',
    title: "Let's get in touch.",
    lead: 'Whether you have questions about my work, want to exchange ideas or just say hello – drop me a line, I look forward to hearing from you.',
    email: 'Email', location: 'Location', locationValue: 'Kriens / Lucerne, Switzerland',
    languages: 'Languages', languagesValue: 'German, English', cv: 'CV (German)',
    name: 'Name', namePh: 'Your name', mailPh: 'you@company.com',
    company: 'Company', optional: '(optional)', companyPh: 'Your company',
    message: 'What is it about?', messagePh: 'Your message to me …',
    error: 'Please fill in your name, email and message.',
    saveTitle: 'Save my contact',
    saveText: 'Scan the code with your phone camera and save my contact details with one tap.',
    saveTextTouch: 'Save my contact details to your address book with one tap.',
    saveBtn: 'Download vCard', saveBtnTouch: 'Save contact',
    submit: 'Send message', note: 'Opens your email app with a pre-filled message.',
    mail: { subject: 'Message from', email: 'Email', company: 'Company', message: 'Message' },
  },
}[lang];

// QR code pointing to the vCard file. A short URL keeps the code coarse and easy to scan
// (embedding the whole card made it too dense); the file also carries the photo.
const qrSvg = await QRCode.toString(new URL(vcardPath, Astro.site).href, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 0,
  color: { dark: '#222833', light: '#ffffff' },
});
---
<section id="kontakt" class="section contact">
  <Floaters set="contact" />
  <div class="wrap">
    <div class="contact-card">

      <div class="contact-intro reveal rv-left">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2>{t.title}</h2>
        <p class="contact-lead">{t.lead}</p>

        <ul class="contact-list reveal rv-stagger rv-left">
          <li>
            <span class="ci" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            </span>
            <div>
              <span class="cl">{t.email}</span>
              <a href="mailto:kontakt@alpzen-group.ch">kontakt@alpzen-group.ch</a>
            </div>
          </li>
          <li>
            <span class="ci" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div>
              <span class="cl">{t.location}</span>
              <span>{t.locationValue}</span>
            </div>
          </li>
          <li>
            <span class="ci" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </span>
            <div>
              <span class="cl">{t.languages}</span>
              <span>{t.languagesValue}</span>
            </div>
          </li>
        </ul>

        <div class="links">
          <a href="https://www.linkedin.com/in/tim-flavio-ineichen-269a231a8/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href="https://github.com/TimAtOak" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href="/Tim_Ineichen_Lebenslauf.pdf" target="_blank" rel="noopener">{t.cv} ↗</a>
        </div>

        <div class="save-contact reveal rv-zoom">
          <div class="qr" aria-hidden="true" set:html={qrSvg} />
          <div class="save-text">
            <strong>{t.saveTitle}</strong>
            <p class="for-pointer">{t.saveText}</p>
            <p class="for-touch">{t.saveTextTouch}</p>
            <a href={vcardPath} download="Tim-Flavio-Ineichen.vcf" class="save-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M22 11h-6"/></svg>
              <span class="for-pointer">{t.saveBtn}</span>
              <span class="for-touch">{t.saveBtnTouch}</span>
            </a>
          </div>
        </div>
      </div>

      <form class="form reveal rv-right d1" id="contactForm" novalidate data-mail={JSON.stringify(t.mail)}>
        <div class="row">
          <label>
            <span>{t.name}</span>
            <input type="text" id="contact-name" name="name" autocomplete="name" placeholder={t.namePh} required />
          </label>
          <label>
            <span>{t.email}</span>
            <input type="email" id="contact-email" name="email" autocomplete="email" placeholder={t.mailPh} required />
          </label>
        </div>
        <label>
          <span>{t.company} <em>{t.optional}</em></span>
          <input type="text" id="contact-company" name="company" autocomplete="organization" placeholder={t.companyPh} />
        </label>
        <label>
          <span>{t.message}</span>
          <textarea id="contact-message" name="message" rows="5" placeholder={t.messagePh} required></textarea>
        </label>
        <p class="form-error" id="contact-error" role="alert" hidden>{t.error}</p>
        <button type="submit" class="btn btn-primary submit">
          {t.submit}
          <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </button>
        <p class="form-note">{t.note}</p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
  }

  /* Decorative 3D shapes */
  .orb {
    position: absolute;
    pointer-events: none;
    width: 26px;
    height: 26px;
    left: 46%;
    bottom: 10%;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, #ffffff 0%, #c9d1dd 42%, #6f7b8e 100%);
    box-shadow: 0 8px 14px -4px rgba(31, 52, 92, 0.35);
  }

  :global([data-theme="dark"]) .orb { filter: brightness(0.5); }

  .contact-intro { position: relative; }

  .contact h2 {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 1.25rem;
  }

  .contact-lead { color: var(--muted); font-size: 1.08rem; max-width: 44ch; margin: 0 0 2rem; }

  .contact-list { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; gap: 1rem; }

  .contact-list li { display: flex; gap: 0.9rem; align-items: center; }

  .ci {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg-elev);
    color: var(--accent);
    box-shadow: var(--shadow);
  }

  .contact-list div { display: grid; line-height: 1.4; }
  .cl { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); }
  .contact-list a { color: var(--ink); font-weight: 600; text-decoration: none; word-break: break-all; }
  .contact-list a:hover { color: var(--accent); }
  .contact-list span:not(.cl) { color: var(--ink); }

  .links { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    background: var(--bg-elev);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    transition: color 0.2s ease, transform 0.25s var(--ease);
  }

  .links a:hover { color: var(--accent); transform: translateY(-2px); }

  /* Save contact (QR + vCard) */
  .save-contact {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
    padding: 1.1rem 1.4rem 1.1rem 1.1rem;
    max-width: 460px;
    border-radius: var(--radius-sm);
    background: var(--bg-elev);
    box-shadow: var(--shadow);
  }

  /* Always dark on white, also in dark mode – scanners need the contrast */
  .qr {
    flex-shrink: 0;
    width: 124px;
    padding: 8px;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .qr :global(svg) { display: block; width: 100%; height: auto; }

  .save-text { display: grid; gap: 0.35rem; justify-items: start; }
  .save-text strong { color: var(--ink); font-size: 1.02rem; }
  .save-text p { margin: 0 0 0.4rem; color: var(--muted); font-size: 0.9rem; line-height: 1.55; }

  .save-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .save-btn:hover { color: var(--accent-hover); }

  /* Phones & tablets can't scan their own screen: hide the QR, offer the one-tap download */
  .for-touch { display: none; }

  @media (hover: none) and (pointer: coarse) {
    .qr, .for-pointer { display: none; }
    .for-touch { display: revert; }
    .save-contact { padding: 1.1rem 1.4rem; }
    .save-btn {
      margin-top: 0.2rem;
      padding: 0.6rem 1.1rem;
      border-radius: 999px;
      background: var(--accent);
      color: var(--on-accent);
      box-shadow: var(--glow);
    }
    .save-btn:hover { color: var(--on-accent); }
  }

  /* Form */
  .form {
    position: relative;
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }

  label { display: grid; gap: 0.4rem; }
  label span { font-size: 0.85rem; font-weight: 600; color: var(--ink); }
  label em { font-style: normal; font-weight: 400; color: var(--faint); }

  input, textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    resize: vertical;
  }

  input::placeholder, textarea::placeholder { color: var(--faint); }

  input:focus, textarea:focus {
    outline: none;
    background: var(--bg-elev);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .form-error { margin: 0; color: #e5484d; font-size: 0.9rem; }

  .submit { justify-self: start; margin-top: 0.4rem; }

  .form-note { margin: 0; font-size: 0.82rem; color: var(--faint); }

  @media (max-width: 900px) {
    .contact-card { grid-template-columns: minmax(0, 1fr); }
    .orb { display: none; }
  }

  @media (max-width: 560px) {
    .row { grid-template-columns: minmax(0, 1fr); }
    .submit { justify-self: stretch; }
  }
</style>

<script>
  const form = document.getElementById('contactForm');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const labels = JSON.parse(form.dataset.mail || '{}');
    const value = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement).value.trim();

    const name = value('contact-name');
    const email = value('contact-email');
    const company = value('contact-company');
    const message = value('contact-message');
    const error = document.getElementById('contact-error');

    if (!name || !email || !message) {
      if (error) error.hidden = false;
      return;
    }
    if (error) error.hidden = true;

    const companyLine = company ? `${labels.company}: ${company}\n` : '';
    const subject = encodeURIComponent(`${labels.subject} ${name}`);
    const body = encodeURIComponent(`Name: ${name}\n${labels.email}: ${email}\n${companyLine}\n${labels.message}:\n${message}`);
    window.location.href = `mailto:kontakt@alpzen-group.ch?subject=${subject}&body=${body}`;
  });
</script>
