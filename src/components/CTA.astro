---
<section class="contact-section">
    <div class="contact-container">
        <div class="contact-header reveal">
            <span class="section-label">Kontakt</span>
            <h2>Projekt anfragen</h2>
            <p>Haben Sie ein Projekt, bei dem Sie Unterstützung benötigen? Ich freue mich auf Ihre Nachricht.</p>
        </div>

        <div class="contact-layout reveal d1">
            <div class="contact-info">
                <div class="info-item">
                    <div class="info-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </div>
                    <div>
                        <span class="info-label">E-Mail</span>
                        <a href="mailto:ineichen.tim@gmail.com" class="info-value link">ineichen.tim@gmail.com</a>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div>
                        <span class="info-label">Standort</span>
                        <span class="info-value">Baldegg, Schweiz</span>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </div>
                    <div>
                        <span class="info-label">Verfügbarkeit</span>
                        <span class="info-value">Auf Anfrage</span>
                    </div>
                </div>
                <div class="social-row">
                    <a href="https://github.com/TimAtOak" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                        </svg>
                    </a>
                    <a href="https://www.linkedin.com/in/tim-flavio-ineichen-269a231a8/" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                        </svg>
                    </a>
                </div>
            </div>

            <form class="contact-form" id="contactForm" novalidate>
                <div class="form-row">
                    <div class="form-group">
                        <label for="contact-name">Name</label>
                        <input type="text" id="contact-name" name="name" placeholder="Ihr Name" required />
                    </div>
                    <div class="form-group">
                        <label for="contact-email">E-Mail</label>
                        <input type="email" id="contact-email" name="email" placeholder="ihre@email.ch" required />
                    </div>
                </div>
                <div class="form-group">
                    <label for="contact-company">Unternehmen <span class="optional">(optional)</span></label>
                    <input type="text" id="contact-company" name="company" placeholder="Ihr Unternehmen" />
                </div>
                <div class="form-group">
                    <label for="contact-message">Nachricht</label>
                    <textarea id="contact-message" name="message" rows="5" placeholder="Beschreiben Sie Ihr Projekt oder Ihre Anfrage..." required></textarea>
                </div>
                <button type="submit" class="submit-btn">
                    Nachricht senden
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="22" y1="2" x2="11" y2="13"/>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</section>

<style>
    .contact-section {
        padding: 5rem 2rem 7rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .contact-header {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    .section-label {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent-soft);
        margin-bottom: 0.75rem;
    }

    .contact-header h2 {
        color: var(--heading);
        font-size: 3rem;
        font-weight: 800;
        margin: 0 0 1rem 0;
        line-height: 1;
    }

    .contact-header p {
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.7;
        max-width: 480px;
        margin: 0 auto;
    }

    .contact-layout {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 3rem;
        align-items: start;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 1.25rem;
        padding: 2.5rem 3rem;
        box-shadow: var(--shadow-card);
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        padding-top: 0.5rem;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 0.875rem;
    }

    .info-icon {
        color: var(--accent-soft);
        flex-shrink: 0;
        margin-top: 1px;
    }

    .info-label {
        display: block;
        font-size: 0.75rem;
        color: var(--text-faint);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.2rem;
    }

    .info-value {
        color: var(--text);
        font-size: 0.92rem;
        text-decoration: none;
    }

    .info-value.link:hover {
        color: var(--accent-soft);
    }

    .social-row {
        display: flex;
        gap: 0.65rem;
        margin-top: 0.25rem;
    }

    .social-btn {
        color: var(--text-faint);
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        background: var(--accent-dim);
        border: 1px solid var(--border);
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .social-btn:hover {
        color: var(--accent-soft);
        border-color: var(--border-hover);
        transform: translateY(-2px);
    }

    /* Form */
    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .form-group label {
        font-size: 0.82rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    .optional {
        color: var(--text-faint);
        font-size: 0.78rem;
        font-weight: 400;
    }

    .form-group input,
    .form-group textarea {
        background: var(--input-bg);
        border: 1px solid var(--input-border);
        border-radius: 0.5rem;
        padding: 0.7rem 0.9rem;
        color: var(--text);
        font-family: inherit;
        font-size: 0.92rem;
        transition: border-color 0.2s ease, background 0.2s ease;
        resize: vertical;
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
        color: var(--text-faint);
    }

    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: var(--accent);
        background: var(--accent-dim);
    }

    .submit-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.8rem 2rem;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 0.5rem;
        font-family: inherit;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        align-self: flex-start;
    }

    .submit-btn:hover {
        background: var(--accent-soft);
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);
    }

    @media (max-width: 900px) {
        .contact-layout {
            grid-template-columns: 1fr;
            gap: 2rem;
            padding: 2rem;
        }
    }

    @media (max-width: 768px) {
        .contact-section {
            padding: 4rem 1rem 5rem;
        }

        .contact-header h2 {
            font-size: 2.25rem;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .submit-btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<script>
    document.getElementById('contactForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        const name    = (document.getElementById('contact-name')    as HTMLInputElement).value.trim();
        const email   = (document.getElementById('contact-email')   as HTMLInputElement).value.trim();
        const company = (document.getElementById('contact-company') as HTMLInputElement).value.trim();
        const message = (document.getElementById('contact-message') as HTMLTextAreaElement).value.trim();
        if (!name || !email || !message) return;
        const companyLine = company ? `Unternehmen: ${company}\n` : '';
        const subject = encodeURIComponent(`Projektanfrage von ${name}`);
        const body    = encodeURIComponent(`Name: ${name}\nE-Mail: ${email}\n${companyLine}\nNachricht:\n${message}`);
        window.location.href = `mailto:ineichen.tim@gmail.com?subject=${subject}&body=${body}`;
    });
</script>
