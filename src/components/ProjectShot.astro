---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  url: string;
  /** Rendered width hint for the optimised image. */
  width?: number;
  eager?: boolean;
}

const { image, url, width = 900, eager = false } = Astro.props;
const host = new URL(url).host.replace(/^www\./, '');
---
<div class="shot">
  <Image src={image} alt={`${host} – Screenshot`} width={width} loading={eager ? 'eager' : 'lazy'} />
</div>

<style>
  .shot {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.8s var(--ease);
  }
</style>
