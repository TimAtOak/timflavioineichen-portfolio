---
import { homePath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const year = new Date().getFullYear();

const t = {
  de: { email: 'E-Mail', imprint: 'Impressum', privacy: 'Datenschutz' },
  en: { email: 'Email', imprint: 'Legal notice', privacy: 'Privacy' },
}[lang];
---
<footer class="footer">
  <div class="wrap footer-inner">
    <a href={homePath(lang)} class="brand">tim<span>.</span></a>
    <p class="footer-name">© {year} Tim Flavio Ineichen</p>
    <nav class="footer-links" aria-label="Footer">
      <a href="https://www.linkedin.com/in/tim-flavio-ineichen-269a231a8/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/TimAtOak" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:kontakt@alpzen-group.ch">{t.email}</a>
      <span class="sep" aria-hidden="true"></span>
      <a href="/impressum" hreflang="de">{t.imprint}</a>
      <a href="/dsgvo" hreflang="de">{t.privacy}</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding: 1.5rem 0 2.5rem;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .brand {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--ink);
    text-decoration: none;
  }

  .brand span { color: var(--accent); }

  .footer-name { margin: 0; flex: 1; }

  .footer-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.25rem; }

  .footer-links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover { color: var(--accent); }

  .sep { width: 1px; height: 14px; background: var(--line); }
</style>
