---

<footer id="footer">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-left">
        <div class="copyright">
          <span>©</span>
          <span>2025</span>
          <span class="copyright-name">Tim Flavio Ineichen</span>
          <span>– Alle Rechte vorbehalten</span>
        </div>
      </div>

      <div class="footer-center">
        <nav class="social-links">
          <a href="https://github.com/TimAtOak" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
            <i class="fab fa-github"></i>
          </a>
          <a href="https://www.linkedin.com/in/tim-flavio-ineichen-269a231a8/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
            <i class="fab fa-linkedin"></i>
          </a>
          <a href="mailto:ineichen.tim@gmail.com" class="social-link" aria-label="E-Mail">
            <i class="fas fa-envelope"></i>
          </a>
        </nav>
      </div>

      <div class="footer-right">
        <nav class="legal-links">
          <a href="/impressum" class="legal-link">Impressum</a>
          <span class="separator">|</span>
          <a href="/dsgvo" class="legal-link">Datenschutz</a>
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="made-with">
        Gebaut mit <span class="tech">Astro</span> & <span class="heart">♥</span>
      </div>
    </div>
  </div>
</footer>

<style>
  #footer {
    width: 100%;
    background: rgba(8, 14, 28, 0.98);
    border-top: 1px solid rgba(59, 130, 246, 0.12);
    padding: 40px 0 20px 0;
    font-family: inherit;
    color: #8b949e;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }

  .copyright {
    font-size: 13px;
    color: #6b7280;
    display: flex;
    gap: 5px;
    align-items: center;
  }

  .copyright-name {
    color: #58a6ff;
  }

  .social-links {
    display: flex;
    gap: 22px;
    align-items: center;
  }

  .social-link {
    color: #6b7280;
    text-decoration: none;
    font-size: 20px;
    transition: all 0.25s ease;
  }

  .social-link:hover {
    color: #58a6ff;
    transform: translateY(-2px);
  }

  .legal-links {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .legal-link {
    color: #6b7280;
    text-decoration: none;
    font-size: 13px;
    transition: color 0.25s ease;
  }

  .legal-link:hover {
    color: #58a6ff;
  }

  .separator {
    color: #30363d;
  }

  .footer-bottom {
    text-align: center;
    padding-top: 20px;
    border-top: 1px solid rgba(59, 130, 246, 0.08);
  }

  .made-with {
    font-size: 13px;
    color: #6b7280;
  }

  .tech {
    color: #58a6ff;
  }

  .heart {
    color: #f85149;
    display: inline-block;
    animation: pulse 1.8s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50%       { transform: scale(1.15); }
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }

    .social-links { justify-content: center; }
    .legal-links  { justify-content: center; }
    .copyright    { justify-content: center; flex-wrap: wrap; }
  }
</style>
