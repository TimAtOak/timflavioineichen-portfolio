---
import Floaters from './Floaters.astro';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;

const t = {
  de: {
    eyebrow: 'Über mich',
    title: 'Pragmatische Architektur für Software, die im Alltag besteht.',
    education: 'Ausbildung',
    stack: 'Tech-Stack',
    groups: ['Sprachen', 'Frontend', 'Daten', 'Plattformen', 'Delivery'],
    edu: [
      { period: 'seit 2024', title: 'Professional Bachelor HF Software Engineering', org: 'TEKO Schweizerische Fachschule' },
      { period: '2025', title: 'Führungsseminar', org: 'TEKO – swispo GmbH' },
      { period: '2017 – 2021', title: 'Informatiker EFZ Applikationsentwicklung', org: 'Benedict Schulen Schweiz' },
    ],
  },
  en: {
    eyebrow: 'About me',
    title: 'Pragmatic architecture for software that holds up in daily use.',
    education: 'Education',
    stack: 'Tech stack',
    groups: ['Languages', 'Frontend', 'Data', 'Platforms', 'Delivery'],
    edu: [
      { period: 'since 2024', title: 'Professional Bachelor (HF) in Software Engineering', org: 'TEKO Swiss Technical College' },
      { period: '2025', title: 'Leadership seminar', org: 'TEKO – swispo GmbH' },
      { period: '2017 – 2021', title: 'Federal VET Diploma in Application Development (Informatiker EFZ)', org: 'Benedict School Switzerland' },
    ],
  },
}[lang];

const stackItems = [
  ['TypeScript', 'JavaScript', 'PHP (Symfony)', 'Python', 'C#'],
  ['React', 'Vue', 'Astro', 'Component Libraries', 'UI/UX'],
  ['PostgreSQL', 'MySQL / MariaDB', 'MSSQL', 'SQLite'],
  ['Odoo', 'Symfony', 'Pimcore / Sulu', 'Craft CMS', 'WordPress'],
  ['Docker', 'CI/CD', 'Testing', 'GitLab', 'Azure DevOps', 'Gitea'],
];

const stack = t.groups.map((group, i) => ({ group, items: stackItems[i] }));
const education = t.edu;
---
<section id="ueber-mich" class="section">
  <Floaters set="about" />
  <div class="wrap">
    <div class="about-grid">
      <div class="about-text">
        <div class="section-head reveal rv-stagger rv-blur">
          <p class="eyebrow">{t.eyebrow}</p>
          <h2 class="section-title">{t.title}</h2>
        </div>

        {lang === 'de' ? (
          <div class="reveal rv-left d1">
            <p class="lead">
              Ich bin Senior Software Engineer &amp; Architect aus der Region Luzern und arbeite
              als Freelancer. Daneben bin ich CTO bei
              <a href="https://kimuno.ch/" target="_blank" rel="noopener">kimuno</a>, wo wir öffentliche Institutionen
              und KMU mit Digitalisierung, Software und KI unterstützen, und Lead Developer bei
              <a href="https://letsdoo.it/" target="_blank" rel="noopener">Let's Doo</a>, einem Odoo-Partner
              für KMU in der Zentralschweiz.
            </p>
            <p>
              Mein Weg führte von der Lehre als Applikationsentwickler über Agentur-Projekte und
              Requirements Engineering bis zur Architektur einer QM-Software für ISO-zertifizierte Unternehmen
              sowie zur technischen Leitung als Mitgründer von Alpzen. Diese Mischung prägt meine Arbeitsweise:
              Ich verstehe die fachliche Seite, übersetze sie in saubere technische Konzepte und setze sie selbst um.
            </p>
            <p>
              Mir sind klare Schnittstellen, wartbarer Code und ehrliche Kommunikation wichtig – und dass
              ein System auch in zwei Jahren noch gerne weiterentwickelt wird.
            </p>
          </div>
        ) : (
          <div class="reveal rv-left d1">
            <p class="lead">
              I'm a Senior Software Engineer &amp; Architect based near Lucerne, Switzerland, working
              as a freelancer. I'm also CTO at
              <a href="https://kimuno.ch/" target="_blank" rel="noopener">kimuno</a>, where we help public institutions
              and SMEs with digitalisation, software and AI, and Lead Developer at
              <a href="https://letsdoo.it/" target="_blank" rel="noopener">Let's Doo</a>, an Odoo partner
              for SMEs in Central Switzerland.
            </p>
            <p>
              My path led from an apprenticeship in application development through agency projects and
              requirements engineering to architecting QMS software for ISO-certified companies and leading
              technology as co-founder of Alpzen. That mix shapes how I work: I understand the business side,
              translate it into clean technical concepts and build them myself.
            </p>
            <p>
              I care about clear interfaces, maintainable code and honest communication – and about systems
              that people are still happy to work on two years from now.
            </p>
          </div>
        )}

        <div class="edu reveal rv-up d2">
          <h3 class="block-title">
            <span class="block-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>
            </span>
            {t.education}
          </h3>
          <ul>
            {education.map((e) => (
              <li>
                <span class="edu-period">{e.period}</span>
                <span class="edu-title">{e.title}</span>
                <span class="edu-org">{e.org}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="stack reveal rv-right d1">
        <h3 class="block-title">
          <span class="block-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </span>
          {t.stack}
        </h3>
        <dl>
          {stack.map((s) => (
            <div class="stack-row">
              <dt>{s.group}</dt>
              <dd class="tags reveal rv-stagger rv-pop">{s.items.map((i) => <span class="tag">{i}</span>)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .about-text p {
    color: var(--muted);
    line-height: 1.8;
    margin: 0 0 1.1rem;
  }

  .about-text p.lead { color: var(--ink); font-size: 1.2rem; line-height: 1.7; }

  .about-text a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid var(--accent-soft);
    transition: border-color 0.2s ease;
  }

  .about-text a:hover { border-color: var(--accent); }

  .block-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-size: 1.1rem;
    font-weight: 750;
    color: var(--ink);
    margin: 0 0 1.25rem;
  }

  .block-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .edu { margin-top: 2.5rem; }

  .edu ul { list-style: none; padding: 0; margin: 0; }

  .edu li {
    display: grid;
    grid-template-columns: 110px 1fr;
    column-gap: 1rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
  }

  .edu-period {
    grid-row: span 2;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    padding-top: 0.1rem;
  }

  .edu-title { font-weight: 600; color: var(--ink); line-height: 1.4; }
  .edu-org { color: var(--muted); font-size: 0.9rem; }

  .stack {
    position: sticky;
    top: 104px;
    padding-top: 0.5rem;
  }

  .stack dl { margin: 0; }

  .stack-row {
    display: grid;
    gap: 0.6rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .stack-row dt { font-size: 0.85rem; font-weight: 600; color: var(--muted); }
  .stack-row dd { margin: 0; }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: minmax(0, 1fr); }
    .stack { position: static; }
  }

  @media (max-width: 520px) {
    .edu li { grid-template-columns: minmax(0, 1fr); }
    .edu-period { grid-row: auto; }
  }
</style>
