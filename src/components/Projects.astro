---
import { projects, panelStyle } from '../data/projects';

const [featured, ...rest] = projects;
---
<section id="projekte" class="section">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">Projekte</p>
      <h2 class="section-title">Ausgewählte Arbeiten.</h2>
      <p class="section-lead">Unternehmen und Produkte, die ich technisch verantworte oder verantwortet habe.</p>
    </div>

    <div class="projects">
      <a href={`/projekte/${featured.slug}`} class="project card is-featured reveal" style={panelStyle(featured)}>
        <div class="panel">
          <span class="panel-num">{featured.number}</span>
          <span class="panel-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={featured.iconPath}/></svg>
          </span>
          {featured.badge && <span class="badge">{featured.badge}</span>}
        </div>
        <div class="body">
          <p class="meta">{featured.role} · {featured.period}</p>
          <h3>{featured.title}</h3>
          <p class="tagline">{featured.tagline}</p>
          <p class="desc">{featured.shortDescription}</p>
          <div class="tags">{featured.techStack.slice(0, 5).map((t) => <span class="tag">{t}</span>)}</div>
          <span class="more">Projekt ansehen <span aria-hidden="true">→</span></span>
        </div>
      </a>

      {rest.map((p, i) => (
        <a href={`/projekte/${p.slug}`} class={`project card reveal d${i + 1}`} style={panelStyle(p)}>
          <div class="panel">
            <span class="panel-num">{p.number}</span>
            <span class="panel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={p.iconPath}/></svg>
            </span>
            {p.badge && <span class="badge">{p.badge}</span>}
          </div>
          <div class="body">
            <p class="meta">{p.role} · {p.period}</p>
            <h3>{p.title}</h3>
            <p class="tagline">{p.tagline}</p>
            <p class="desc">{p.shortDescription}</p>
            <div class="tags">{p.techStack.slice(0, 4).map((t) => <span class="tag">{t}</span>)}</div>
            <span class="more">Ansehen <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2vw, 28px);
  }

  .project {
    display: flex;
    flex-direction: column;
    padding: 12px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .project:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }

  .is-featured { grid-column: 1 / -1; flex-direction: row; }

  .panel {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: calc(var(--radius) - 8px);
    background: linear-gradient(135deg, var(--panel-from), var(--panel-to));
    color: var(--panel-ink);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .is-featured .panel { flex: 0 0 50%; aspect-ratio: auto; min-height: 340px; }

  .panel-num {
    position: absolute;
    left: 1.25rem;
    bottom: -0.12em;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: clamp(4.5rem, 10vw, 8rem);
    font-weight: 900;
    line-height: 1;
    opacity: 0.18;
  }

  .panel-icon {
    width: 104px;
    height: 104px;
    display: grid;
    place-items: center;
    border-radius: 28px;
    background: color-mix(in srgb, #ffffff 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, #ffffff 30%, transparent), 0 20px 40px -12px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(6px);
    transition: transform 0.6s var(--ease);
  }

  .panel-icon svg { width: 50px; height: 50px; }

  .project:hover .panel-icon { transform: translateY(-6px) rotate(-4deg); }

  .badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #ffffff;
    color: var(--accent);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }

  .body {
    padding: clamp(18px, 3vw, 32px) clamp(14px, 2.5vw, 28px) clamp(14px, 2vw, 20px);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .is-featured .body { justify-content: center; padding-left: clamp(20px, 4vw, 48px); }

  .meta { font-size: 0.85rem; color: var(--muted); margin: 0 0 0.5rem; }

  .project h3 {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 850;
    color: var(--ink);
    margin: 0 0 0.25rem;
    line-height: 1.1;
  }

  .is-featured h3 { font-size: clamp(1.9rem, 3.6vw, 2.8rem); }

  .tagline { margin: 0 0 0.9rem; color: var(--accent); font-weight: 600; }

  .desc { color: var(--muted); line-height: 1.7; margin: 0 0 1.3rem; flex: 1; }
  .is-featured .desc { flex: 0; font-size: 1.05rem; }

  .more {
    margin-top: 1.4rem;
    font-weight: 600;
    color: var(--accent);
    display: inline-flex;
    gap: 0.4rem;
  }

  .more span { transition: transform 0.3s var(--ease); }
  .project:hover .more span { transform: translateX(4px); }

  @media (max-width: 860px) {
    .projects { grid-template-columns: 1fr; }
    .is-featured { flex-direction: column; }
    .is-featured .panel { min-height: 0; aspect-ratio: 16 / 9; }
    .is-featured .body { padding-left: clamp(14px, 2.5vw, 28px); }
  }
</style>
