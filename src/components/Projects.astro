---
import { getProjects, panelStyle } from '../data/projects';
import { projectPath, type Lang } from '../i18n';
import ProjectShot from './ProjectShot.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const [featured, ...rest] = getProjects(lang);

const t = {
  de: {
    eyebrow: 'Projekte',
    title: 'Ausgewählte Arbeiten.',
    lead: 'Unternehmen und Produkte, die ich technisch verantworte oder verantwortet habe.',
    viewProject: 'Projekt ansehen',
    view: 'Ansehen',
  },
  en: {
    eyebrow: 'Projects',
    title: 'Selected work.',
    lead: 'Companies and products I am or have been technically responsible for.',
    viewProject: 'View project',
    view: 'View',
  },
}[lang];
---
<section id="projekte" class="section">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-lead">{t.lead}</p>
    </div>

    <div class="projects">
      <a href={projectPath(lang, featured.slug)} class="project card is-featured reveal" style={panelStyle(featured)}>
        <div class="panel">
          {featured.image && featured.url ? (
            <ProjectShot image={featured.image} url={featured.url} width={1000} />
          ) : (
            <Fragment>
              <span class="panel-num">{featured.number}</span>
              <span class="panel-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={featured.iconPath}/></svg>
              </span>
            </Fragment>
          )}
          {featured.badge && <span class="badge">{featured.badge}</span>}
        </div>
        <div class="body">
          <p class="meta">{featured.role} · {featured.period}</p>
          <h3>{featured.title}</h3>
          <p class="tagline">{featured.tagline}</p>
          <p class="desc">{featured.shortDescription}</p>
          <div class="tags">{featured.techStack.slice(0, 5).map((t) => <span class="tag">{t}</span>)}</div>
          <span class="more">{t.viewProject} <span aria-hidden="true">→</span></span>
        </div>
      </a>

      {rest.map((p, i) => (
        <a href={projectPath(lang, p.slug)} class={`project card reveal d${i + 1}`} style={panelStyle(p)}>
          <div class="panel">
            {p.image && p.url ? (
              <ProjectShot image={p.image} url={p.url} width={800} />
            ) : (
              <Fragment>
                <span class="panel-num">{p.number}</span>
                <span class="panel-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={p.iconPath}/></svg>
                </span>
              </Fragment>
            )}
            {p.badge && <span class="badge">{p.badge}</span>}
          </div>
          <div class="body">
            <p class="meta">{p.role} · {p.period}</p>
            <h3>{p.title}</h3>
            <p class="tagline">{p.tagline}</p>
            <p class="desc">{p.shortDescription}</p>
            <div class="tags">{p.techStack.slice(0, 4).map((t) => <span class="tag">{t}</span>)}</div>
            <span class="more">{t.view} <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  .project {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .project:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }

  .is-featured { grid-column: 1 / -1; flex-direction: row; }

  .panel {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--panel-from), var(--panel-to));
    color: var(--panel-ink);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .is-featured .panel { flex: 0 0 50%; aspect-ratio: auto; min-height: 340px; }

  .panel-num {
    position: absolute;
    left: 1.25rem;
    bottom: -0.12em;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: clamp(4.5rem, 10vw, 8rem);
    font-weight: 900;
    line-height: 1;
    opacity: 0.18;
  }

  .panel-icon {
    width: 104px;
    height: 104px;
    display: grid;
    place-items: center;
    border-radius: 28px;
    background: color-mix(in srgb, #ffffff 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, #ffffff 30%, transparent), 0 20px 40px -12px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(6px);
    transition: transform 0.6s var(--ease);
  }

  .panel-icon svg { width: 50px; height: 50px; }

  .project:hover .panel-icon { transform: translateY(-6px) rotate(-4deg); }
  .project:hover .panel :global(.shot img) { transform: scale(1.04); }

  .badge {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #ffffff;
    color: var(--accent);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }

  .body {
    padding: clamp(20px, 3vw, 32px) clamp(20px, 3vw, 36px) clamp(22px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .is-featured .body { justify-content: center; padding-left: clamp(20px, 4vw, 48px); }

  .meta { font-size: 0.85rem; color: var(--muted); margin: 0 0 0.5rem; }

  .project h3 {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 850;
    color: var(--ink);
    margin: 0 0 0.25rem;
    line-height: 1.1;
  }

  .is-featured h3 { font-size: clamp(1.9rem, 3.6vw, 2.8rem); }

  .tagline { margin: 0 0 0.9rem; color: var(--accent); font-weight: 600; }

  .desc { color: var(--muted); line-height: 1.7; margin: 0 0 1.3rem; flex: 1; }
  .is-featured .desc { flex: 0; font-size: 1.05rem; }

  .more {
    margin-top: 1.4rem;
    font-weight: 600;
    color: var(--accent);
    display: inline-flex;
    gap: 0.4rem;
  }

  .more span { transition: transform 0.3s var(--ease); }
  .project:hover .more span { transform: translateX(4px); }

  @media (max-width: 860px) {
    .projects { grid-template-columns: minmax(0, 1fr); }
    .is-featured { flex-direction: column; }
    /* Reset the row-layout flex-basis: in a column, Safari resolves it as a height
       and derives an over-wide width from the aspect ratio. */
    .is-featured .panel { flex: none; width: 100%; min-height: 0; aspect-ratio: 16 / 9; }
    .is-featured .body { padding-left: clamp(20px, 3vw, 36px); }
  }
</style>
