---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { getProjects, getAdjacentProject, panelStyle } from '../data/projects';
import { homePath, projectPath, type Lang } from '../i18n';
import ProjectShot from './ProjectShot.astro';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const project = getProjects(lang).find((p) => p.slug === slug)!;
const next = getAdjacentProject(lang, slug);
const home = homePath(lang);
const otherLang: Lang = lang === 'de' ? 'en' : 'de';

const t = {
  de: {
    back: 'Alle Projekte', visit: 'Website besuchen', about: 'Über das Projekt', next: 'Nächstes Projekt',
    askTitle: 'Ähnliche Anforderungen?', askText: 'Lassen Sie uns gemeinsam herausfinden, wie ich Ihr Projekt unterstützen kann.',
    cta: 'Projekt anfragen',
  },
  en: {
    back: 'All projects', visit: 'Visit website', about: 'About the project', next: 'Next project',
    askTitle: 'Similar requirements?', askText: "Let's find out together how I can support your project.",
    cta: 'Start a project',
  },
}[lang];
---

<Layout
  lang={lang}
  title={`${project.title} – ${project.tagline} | Tim Flavio Ineichen`}
  description={project.shortDescription}
  alternates={{ de: projectPath('de', slug), en: projectPath('en', slug) }}
>
  <Nav lang={lang} base={home} altHref={projectPath(otherLang, slug)} />

  <main>
    <header class="detail-hero">
      <div class="wrap">
        <div class="hero-card">
          <div class="hero-copy">
            <a href={`${home}#projekte`} class="back"><span aria-hidden="true">←</span> {t.back}</a>
            <p class="eyebrow reveal">{project.role} · {project.period}</p>
            <h1 class="reveal d1">{project.title}</h1>
            <p class="tagline reveal d2">{project.tagline}</p>
            <div class="tags reveal d3">{project.techStack.map(t => <span class="tag">{t}</span>)}</div>
            {project.url && (
              <a href={project.url} class="btn btn-primary visit reveal d3" target="_blank" rel="noopener">
                {t.visit} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>

          <div class="panel reveal d2" style={panelStyle(project)} aria-hidden="true">
            {project.image && project.url ? (
              <ProjectShot image={project.image} url={project.url} width={1200} eager />
            ) : (
              <Fragment>
                <span class="panel-num">{project.number}</span>
                <span class="panel-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={project.iconPath}/></svg>
                </span>
              </Fragment>
            )}
          </div>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="wrap content-grid">
        <div class="desc reveal">
          <p class="eyebrow">{t.about}</p>
          {project.fullDescription.map((para, i) => <p class={i === 0 ? 'lead' : ''}>{para}</p>)}
        </div>

        <ol class="highlights">
          {project.highlights.map((h, i) => (
            <li class={`reveal d${i + 1}`}>
              <span class="h-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <h3>{h.title}</h3>
              <p>{h.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section next-section">
      <div class="wrap next-grid">
        <a href={projectPath(lang, next.slug)} class="next reveal">
          <span class="eyebrow">{t.next}</span>
          <span class="next-title">{next.title} <span aria-hidden="true">→</span></span>
          <span class="next-tagline">{next.tagline}</span>
        </a>
        <div class="ask reveal d1">
          <h2>{t.askTitle}</h2>
          <p>{t.askText}</p>
          <a href={`${home}#kontakt`} class="btn ask-btn">
            {t.cta}
            <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .detail-hero { padding-top: 96px; }

  .hero-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    padding: clamp(24px, 4vw, 48px) 0 0;
  }

  .back {
    display: inline-flex;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }

  .back:hover { color: var(--accent); }

  .hero-copy .eyebrow { display: flex; }

  h1 {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: clamp(2.6rem, 6.5vw, 5rem);
    font-weight: 900;
    line-height: 0.98;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 0.9rem;
    text-shadow: 3px 3px 0 var(--bg-elev), 5px 5px 0 var(--name-shadow);
  }

  .tagline {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 1.5rem;
  }

  .visit { margin-top: 2rem; }

  .panel {
    position: relative;
    aspect-ratio: 9 / 5;
    border-radius: 28px;
    background: linear-gradient(135deg, var(--panel-from), var(--panel-to));
    color: var(--panel-ink);
    display: grid;
    place-items: center;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .panel-num {
    position: absolute;
    left: 1.25rem;
    bottom: -0.12em;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: clamp(5rem, 13vw, 10rem);
    font-weight: 900;
    line-height: 1;
    opacity: 0.18;
  }

  .panel-icon {
    width: 128px;
    height: 128px;
    display: grid;
    place-items: center;
    border-radius: 32px;
    background: color-mix(in srgb, #ffffff 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, #ffffff 30%, transparent), 0 20px 40px -12px rgba(0, 0, 0, 0.25);
  }

  .panel-icon svg { width: 62px; height: 62px; }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .desc p { color: var(--muted); line-height: 1.8; margin: 0 0 1.1rem; }
  .desc p.lead { color: var(--ink); font-size: clamp(1.1rem, 1.8vw, 1.25rem); line-height: 1.65; }

  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(14px, 2vw, 20px);
  }

  .highlights li { padding-top: 1.25rem; border-top: 1px solid var(--line); }

  .h-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .highlights h3 {
    margin: 1rem 0 0.35rem;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 1.05rem;
    font-weight: 750;
    color: var(--ink);
  }

  .highlights p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.6; }

  .next-section { padding-top: 0; }

  .next-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2vw, 24px);
  }

  .next, .ask { padding: clamp(24px, 4vw, 48px); border-radius: var(--radius); }

  .next {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .next { border: 1px solid var(--line); }
  .next:hover { border-color: var(--accent); }

  .next-title {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 900;
    color: var(--ink);
    line-height: 1.05;
  }

  .next-title span { display: inline-block; color: var(--accent); transition: transform 0.3s var(--ease); }
  .next:hover .next-title span { transform: translateX(6px); }

  .next-tagline { color: var(--muted); }

  .ask {
    background: linear-gradient(135deg, #4aa8f0, var(--accent) 60%, #0f63b8);
    color: #ffffff;
    box-shadow: var(--glow);
  }

  .ask h2 {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-stretch: 120%;
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    font-weight: 850;
  }

  .ask p { margin: 0 0 1.75rem; opacity: 0.9; }

  .ask-btn { background: #ffffff; color: var(--accent); box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.4); }

  @media (max-width: 900px) {
    .hero-card, .content-grid, .next-grid { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 560px) {
    .highlights { grid-template-columns: minmax(0, 1fr); }
  }
</style>
