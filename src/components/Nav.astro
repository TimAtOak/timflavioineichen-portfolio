---
import { homePath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  /** Prefix for section anchors, e.g. the home page URL on sub pages. */
  base?: string;
  /** URL of the current page in the other language. */
  altHref?: string;
}

const { lang = 'de', base = '', altHref } = Astro.props;
const otherLang: Lang = lang === 'de' ? 'en' : 'de';

const t = {
  de: {
    nav: 'Hauptnavigation', home: 'Startseite', theme: 'Farbschema wechseln', contact: 'Kontakt', switchTo: 'English version',
    links: [['ueber-mich', 'Über mich'], ['leistungen', 'Leistungen'], ['werdegang', 'Werdegang'], ['projekte', 'Projekte']],
  },
  en: {
    nav: 'Main navigation', home: 'Home', theme: 'Toggle colour scheme', contact: 'Contact', switchTo: 'Deutsche Version',
    links: [['ueber-mich', 'About'], ['leistungen', 'Services'], ['werdegang', 'Experience'], ['projekte', 'Projects']],
  },
}[lang];

const links = t.links.map(([id, label]) => ({ id, label }));
---
<nav class="nav" id="main-nav" aria-label={t.nav}>
  <div class="wrap nav-inner">
    <a href={base || '#top'} class="brand" aria-label={`Tim Flavio Ineichen – ${t.home}`}>
      tim<span class="brand-dot">.</span>
    </a>

    <div class="nav-links">
      {links.map((l) => (
        <a href={`${base}#${l.id}`} data-section={l.id}>{l.label}</a>
      ))}
    </div>

    <div class="nav-actions">
      <a href={altHref ?? homePath(otherLang)} class="lang-switch" hreflang={otherLang} lang={otherLang} aria-label={t.switchTo}>
        {otherLang.toUpperCase()}
      </a>
      <button class="icon-btn" data-theme-toggle aria-label={t.theme}>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <a href={`${base}#kontakt`} class="nav-cta">{t.contact}</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .nav.is-scrolled {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    box-shadow: var(--shadow-sm);
  }

  .nav-inner {
    height: 80px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    justify-self: start;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }

  .brand-dot { color: var(--accent); }

  .nav-links { display: flex; gap: 2rem; }

  .nav-links a {
    position: relative;
    font-size: 1rem;
    color: var(--text);
    text-decoration: none;
    padding: 0.35rem 0;
    transition: color 0.2s ease;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 18px;
    height: 3px;
    border-radius: 3px;
    background: var(--accent);
    transform: translateX(-50%) scaleX(0);
    transition: transform 0.25s var(--ease);
  }

  .nav-links a:hover,
  .nav-links a.active { color: var(--accent); }
  .nav-links a.active::after { transform: translateX(-50%) scaleX(1); }

  .nav-actions { justify-self: end; display: flex; align-items: center; gap: 0.75rem; }

  .icon-btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 0;
    background: var(--bg-elev);
    box-shadow: var(--shadow);
    color: var(--ink);
    cursor: pointer;
    transition: color 0.2s ease, transform 0.3s var(--ease);
  }

  .lang-switch {
    height: 44px;
    min-width: 44px;
    display: grid;
    place-items: center;
    padding: 0 0.75rem;
    border-radius: 999px;
    background: var(--bg-elev);
    box-shadow: var(--shadow);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lang-switch:hover { color: var(--accent); }

  .icon-btn:hover { color: var(--accent); transform: rotate(20deg); }

  :global([data-theme="dark"]) .icon-moon,
  :global([data-theme="light"]) .icon-sun { display: none; }

  .nav-cta {
    height: 48px;
    display: inline-flex;
    align-items: center;
    padding: 0 1.6rem;
    border-radius: 14px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: var(--glow);
    transition: background-color 0.2s ease, transform 0.25s var(--ease);
  }

  .nav-cta:hover { background: var(--accent-hover); transform: translateY(-2px); }

  @media (max-width: 960px) {
    .nav-inner { grid-template-columns: 1fr auto; }
    .nav-links { display: none; }
  }

  @media (max-width: 420px) {
    .nav-cta { padding: 0 1.1rem; }
  }
</style>

<script>
  const nav = document.getElementById('main-nav');
  const links = document.querySelectorAll<HTMLAnchorElement>('.nav-links a[data-section]');

  function onScroll() {
    nav?.classList.toggle('is-scrolled', window.scrollY > 8);

    const pos = window.scrollY + 140;
    links.forEach((link) => {
      const el = document.getElementById(link.dataset.section || '');
      if (!el) return;
      const inView = pos >= el.offsetTop && pos < el.offsetTop + el.offsetHeight;
      link.classList.toggle('active', inView);
    });
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { onScroll(); ticking = false; });
  }, { passive: true });
  onScroll();
</script>
